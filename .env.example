# Copy this file to .env and fill in your key. .env is git-ignored: never commit it.
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

CLAUDE_MODEL=claude-haiku-5-5

# Claude model for the chat. Default: claude-opus-5-5 (best answers).
# claude-haiku-5-5 is about 40x cheaper; handy while developing.
# CLAUDE_MODEL=claude-haiku-5-5

# Port for the Node server (the Angular dev server proxies /api to it)
PORT=3000
