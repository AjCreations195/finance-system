/* Type-checks the server (npm run typecheck:server). Node runs the .ts files
   directly by stripping the types, so nothing is emitted. */
{
  "compilerOptions": {
    "target": "ES2024",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "include": ["./**/*.ts"]
}
